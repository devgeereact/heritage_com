# HeritOS frontend environment (Vite). Copy to .env.local for local overrides;
# .env.local is gitignored. Only VITE_* values reach the browser, so never put a
# secret here.

# API used by `npm run dev`. Leave unset to use the local staging API
# (http://127.0.0.1:8088, started with `npm run staging:serve`), which holds
# synthetic records only.
#
# Pointing development at production (https://heritclothing.com) reads and
# writes REAL client records. Do that only with the owner's explicit agreement,
# for a specific reason, and with ALLOW_LOCALHOST_CORS switched on in the live
# config.php for the shortest possible time.
# VITE_API_BASE=http://127.0.0.1:8088

# Production builds ignore VITE_API_BASE and always call the API same-origin.

# Clerk publishable key (public) for staff email-code sign-in: pk_test_... for development,
# pk_live_... for the live site. Unset keeps the email-and-password sign-in.
# VITE_CLERK_PUBLISHABLE_KEY=
