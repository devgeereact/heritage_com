# HeritOS — SPA routing for the React build on cPanel (Apache).
# Place this in the document root alongside index.html and the PHP files.

# Shared PHP includes (_lib.php, _domain.php, _jobs.php ...) and config files
# are loaded by the endpoints, never requested directly.
<FilesMatch "^(_.*|config.*)\.php$">
  Require all denied
</FilesMatch>

# API answers are never search results; the sitemap is the one exception.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  <Files "sitemap.php">
    Header unset X-Robots-Tag
  </Files>
</IfModule>

# Security headers on every answer (pages, assets and PHP JSON).
# No script-src CSP yet: it needs a tested allowlist (payment pages, inline
# boot script); frame-ancestors alone stops other sites framing the app.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS only on HTTPS answers; one year, no preload, no subdomains.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Caching: Vite's hashed build files never change, so cache them for a year;
# the page shell and the service worker must always be revalidated after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Self-hosted fonts (public/fonts): names carry no hash, so a month.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compress text answers.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

RewriteEngine On
RewriteBase /

# Always HTTPS (Cloudflare is grey cloud, so the origin sees the real scheme;
# X-Forwarded-Proto covers a proxy in front). Local staging does not use this file.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# The XML sitemap is built from published website content (Phase 4).
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Let real files and the PHP API resolve directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Never rewrite the PHP endpoints.
RewriteRule \.php$ - [L]

# Everything else → index.html so React Router handles the route.
RewriteRule ^ index.html [L]
