# HeritOS — SPA routing for the React build on cPanel (Apache).
# Place this in the document root alongside index.html and the PHP files.

# Shared PHP includes (_lib.php, _domain.php, _jobs.php ...) and config files
# are loaded by the endpoints, never requested directly.
<FilesMatch "^(_.*|config.*)\.php$">
  Require all denied
</FilesMatch>

# API answers are never search results; the sitemap is the one exception.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  <Files "sitemap.php">
    Header unset X-Robots-Tag
  </Files>
  # spa.php serves public pages when link previews are switched on (K-06).
  <Files "spa.php">
    Header unset X-Robots-Tag
  </Files>
</IfModule>

RewriteEngine On
RewriteBase /

# The XML sitemap is built from published website content (Phase 4).
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Let real files and the PHP API resolve directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Never rewrite the PHP endpoints.
RewriteRule \.php$ - [L]

# Everything else → index.html so React Router handles the route.
# Link previews (K-06): to fill each page's title, description and photograph
# for WhatsApp and Facebook, set SPA_HEAD_INJECTION to true in config.php, then
# swap the next two lines (comment the index.html rule, uncomment spa.php).
RewriteRule ^ index.html [L]
# RewriteRule ^ spa.php [L]
